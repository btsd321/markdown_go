{
  "name": "markdown-go",
  "displayName": "Markdown Go",
  "description": "WYSIWYG Markdown editor for beginners",
  "version": "0.1.1",
  "publisher": "btsd321",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/btsd321/markdown_go.git"
  },
  "homepage": "https://github.com/btsd321/markdown_go#readme",
  "bugs": {
    "url": "https://github.com/btsd321/markdown_go/issues"
  },
  "icon": "assets/imgs/markdown-go.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownGo.editor",
        "displayName": "Markdown Go Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.MD"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markdownGo.openWith",
        "title": "%command.openWith.title%",
        "category": "Markdown Go"
      },
      {
        "command": "markdownGo.switchMode",
        "title": "%command.switchMode.title%",
        "category": "Markdown Go"
      },
      {
        "command": "markdownGo.switchLanguage",
        "title": "%command.switchLanguage.title%",
        "category": "Markdown Go"
      }
    ],
    "keybindings": [
      {
        "command": "markdownGo.openWith",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorLangId == markdown"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "markdownGo.openWith",
          "when": "resourceLangId == markdown || resourceExtname =~ /\\.mdx?$/i",
          "group": "navigation@30"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownGo.openWith",
          "when": "resourceLangId == markdown",
          "group": "navigation@30"
        }
      ],
      "editor/context": [
        {
          "command": "markdownGo.openWith",
          "when": "resourceLangId == markdown",
          "group": "navigation@30"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Go",
      "properties": {
        "markdownGo.language": {
          "type": "string",
          "enum": [
            "zh-cn",
            "en"
          ],
          "default": "en",
          "description": "%config.language.description%"
        },
        "markdownGo.defaultMode": {
          "type": "string",
          "enum": [
            "edit",
            "preview",
            "plain"
          ],
          "default": "edit",
          "description": "Default display mode when opening a document"
        },
        "markdownGo.slashTrigger": {
          "type": "string",
          "default": "/",
          "description": "Character that triggers the slash menu"
        },
        "markdownGo.defaultCopyFormat": {
          "type": "string",
          "enum": [
            "markdown",
            "plain"
          ],
          "default": "markdown",
          "description": "%config.defaultCopyFormat.description%"
        },
        "markdownGo.confirmOverwrite": {
          "type": "boolean",
          "default": true,
          "description": "%config.confirmOverwrite.description%"
        },
        "markdownGo.keybindings": {
          "type": "object",
          "default": {},
          "markdownDescription": "Override editor key bindings. Keys are command IDs, values are chord strings (e.g. `\"Ctrl+Shift+Z\"`) or arrays. Use modifiers `Ctrl`/`Cmd`/`Shift`/`Alt`, or `Mod` for cross-platform main modifier (Mac→Cmd, others→Ctrl). Set value to `\"\"` to unbind a default.\n\nAvailable command IDs:\n- `editor.undo`\n- `editor.redo`\n- `editor.enter`\n- `editor.softLineBreak`\n- `editor.backspaceAtStart`\n- `editor.indent`\n- `editor.outdent`\n\nExample:\n```json\n\"markdownGo.keybindings\": {\n  \"editor.indent\": \"Tab\",\n  \"editor.redo\": [\"Mod+Y\", \"Mod+Shift+Z\"]\n}\n```",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.extension.json && tsc --noEmit -p tsconfig.webview.json"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-bubble-menu": "^2.27.2",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "katex": "^0.16.9",
    "mermaid": "^10.6.1",
    "prosemirror-markdown": "^1.13.4"
  }
}
